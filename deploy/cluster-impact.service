[Unit]
Description=Collect and publish DSI cluster impact metrics
Documentation=https://github.com/dsi-clinic/cluster-impact
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# ExecStartPre's git runs as a unit process, not in the container, so it needs
# the deploy key explicitly — root's default identity has no GitHub access and
# the pull fails with "Permission denied (publickey)", which aborts the whole
# oneshot. known_hosts lives under /etc rather than /root because ProtectHome
# below makes /root unreadable to this unit.
Environment="GIT_SSH_COMMAND=ssh -i /etc/cluster-impact/deploy_key -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/cluster-impact/known_hosts"

# A long backfill and a nightly run must not overlap: both write the same
# month files and the same on-cluster state.
ExecStartPre=/usr/bin/flock -n /var/lock/cluster-impact.lock true

# Keep the working copy current before writing into it, so the push at the end
# is a fast-forward in the common case.
ExecStartPre=/usr/bin/git -C /var/lib/cluster-impact/repo pull --rebase --quiet

# Rebuild after pulling. The collector's code AND config are COPY'd into the
# image, so pulling the repo alone changes nothing the container actually runs —
# without this, deployed behaviour silently diverges from main forever. Docker's
# layer cache makes this near-instant when nothing changed, and a build failure
# aborts the oneshot loudly rather than collecting with stale code.
ExecStartPre=/usr/bin/docker build -q -f Containerfile.collector \
    -t cluster-impact-collector:latest /var/lib/cluster-impact/repo

# Runtime is docker, not podman. podman 5.5.0 is installed on cluster-mgmt but
# non-functional: its apt source was purged by Puppet, leaving netavark and
# aardvark-dns uninstallable, so every podman command fails. Docker 27.4.0 is
# present and working on the same host. If podman is ever repaired in Puppet,
# this line and Containerfile.collector's header are the only things to change.
ExecStart=/usr/bin/docker run --rm --name cluster-impact-collect \
    --network host \
    -v /etc/slurm/slurm.conf:/etc/slurm/slurm.conf:ro \
    -v /run/munge/munge.socket.2:/run/munge/munge.socket.2:ro \
    -v /var/lib/cluster-impact/raw:/var/lib/cluster-impact/raw \
    -v /var/lib/cluster-impact/repo:/repo \
    -v /etc/cluster-impact/deploy_key:/secrets/deploy_key:ro \
    -v /etc/cluster-impact/known_hosts:/root/.ssh/known_hosts:ro \
    cluster-impact-collector:latest \
    collect

TimeoutStartSec=3h
Restart=no

# The collector reads accounting data and writes two directories. It has no
# reason to touch anything else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cluster-impact /var/lock

[Install]
WantedBy=multi-user.target
